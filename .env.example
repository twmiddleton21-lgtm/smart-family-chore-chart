# Smart Family Chore Chart: shared family server settings.
# Copy to .env (next to compose.server.yaml) and edit:   cp .env.example .env
#
# No secrets are needed here. Session tokens are generated by the server,
# passwords are chosen in the app, and the one-time setup code is printed
# in the container log at first start. Don't put passwords in this file.

# The exact server image (a versioned tag, never "latest"). Pull it first:
#   docker pull "$(grep ^SFCC_SERVER_IMAGE= .env | cut -d= -f2)"
# For the strongest pinning, use the digest from the release page instead,
# e.g. ghcr.io/twmiddleton21-lgtm/smart-family-chore-chart-server@sha256:<digest>
SFCC_SERVER_IMAGE=ghcr.io/twmiddleton21-lgtm/smart-family-chore-chart-server:0.5.0

# Where the app is published on this machine.
#   127.0.0.1      = this machine only (default, safest)
#   <your LAN IP>  = also other devices on your private network
#                    (find it with: hostname -I, or: ip -4 addr show)
# Never 0.0.0.0: that would publish it on every network this machine is on.
SFCC_BIND_ADDRESS=127.0.0.1

# Port on this machine (check it's free first: ss -ltn | grep ':3080 ').
SFCC_HOST_PORT=3080

# The address you type in the browser, if it isn't localhost/127.0.0.1,
# e.g. the LAN IP above (comma-separate several; add :port to pin one).
# Requests for any other host name are refused (421).
SFCC_ALLOWED_HOSTS=

# Household time zone (IANA name), used for "today".
SFCC_TIMEZONE=Europe/London

# Session cookies: auto (Secure only over HTTPS; right for plain-HTTP LAN
# testing), always (behind an HTTPS reverse proxy), or never.
SFCC_COOKIE_SECURE=auto

# Trusted reverse proxies (IP addresses / CIDR ranges). Leave empty unless a
# proxy sits in front of the app; see docs/DOCKER-SERVER.md first.
SFCC_TRUST_PROXY=

# ---------- Optional: Family Calendar (read-only) ----------
# Full guide: docs/GOOGLE-CALENDAR.md. The encryption key and the Google
# client secret go in files under ./secrets (never in this file).
#
# A private calendar address (iCal) only needs the key:
#   docker compose -p sfcc -f compose.server.yaml -f compose.calendar.yaml up -d
# Google Calendar sign-in (recommended) also needs your own Google OAuth client:
#   docker compose -p sfcc -f compose.server.yaml -f compose.calendar.yaml -f compose.google-calendar.yaml up -d
# Always use the installation's project name (-p sfcc), or Compose starts a
# second, empty server. Or name the project and files once here and use plain
# "docker compose up -d" (a -f on the command line overrides COMPOSE_FILE):
#COMPOSE_PROJECT_NAME=sfcc
#COMPOSE_FILE=compose.server.yaml:compose.calendar.yaml:compose.google-calendar.yaml
#
# Extra host names a calendar address may use besides Google, Outlook/Microsoft
# 365 and iCloud (comma-separated public host names, e.g. a school calendar).
#SFCC_CALENDAR_FEED_HOSTS=
#
# OAuth client ID from your Google Cloud project (not a secret).
#SFCC_GOOGLE_CLIENT_ID=1234567890-abc123.apps.googleusercontent.com
# Exactly as registered in Google Cloud. HTTPS (or http://localhost:<port>),
# ending in /api/calendar/google/callback; its host must be in SFCC_ALLOWED_HOSTS.
#SFCC_GOOGLE_REDIRECT_URI=https://chores.example.com/api/calendar/google/callback

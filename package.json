{
  "name": "smart-family-chore-chart",
  "private": true,
  "version": "0.3.0",
  "type": "module",
  "description": "A cheerful, local-first family chore chart for touchscreens.",
  "engines": {
    "node": "^22.12.0 || ^24.0.0"
  },
  "scripts": {
    "dev": "vite --port 4174 --strictPort",
    "dev:api": "vite --mode api --port 4175 --strictPort",
    "dev:server": "tsx watch server/main.ts --dev-unauthenticated-api",
    "dev:server:auth": "tsx watch server/main.ts",
    "build": "tsc --noEmit && vite build",
    "build:server": "vite build --config vite.server.config.ts",
    "build:app": "tsc --noEmit && vite build --mode api --outDir dist-app --emptyOutDir",
    "preview": "vite preview --port 4174 --strictPort",
    "start:server": "node dist-server/main.js",
    "typecheck": "tsc --noEmit && tsc --noEmit -p server/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "server:cli": "tsx server/cli.ts",
    "verify:docker": "node scripts/verify-docker-rc.mjs"
  },
  "dependencies": {
    "@fastify/cookie": "11.1.2",
    "@fastify/static": "10.1.5",
    "fastify": "5.12.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "tsx": "4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  }
}
